# CORS: Origin fuer ALLE Domains spiegeln, damit das Cookie-/Accessibility-Widget
# auf beliebigen Kundenseiten cross-origin die Banner-Config laden kann.
map $http_origin $cors_allow_origin {
    default                        $http_origin;
}

# Credentialed CORS (Cookies/Authorization) NUR fuer Complyo-eigene Origins.
# Kundendomains bekommen kein Allow-Credentials -> nur oeffentliche, nicht-
# authentifizierte Widget-Reads sind cross-origin lesbar (kein Daten-Leak).
map $http_origin $cors_allow_credentials {
    default                        "";
    "https://app.complyo.de"       "true";
    "https://complyo.de"           "true";
    "https://www.complyo.de"       "true";
    "https://dashboard.complyo.de" "true";
}

server {
    server_name complyo.de www.complyo.de;

    # Security Headers (AUDIT-04, v2.0 milestone Phase 1)
    add_header Strict-Transport-Security "max-age=31536000; includeSubDomains; preload" always;
    add_header X-Content-Type-Options "nosniff" always;
    add_header X-Frame-Options "SAMEORIGIN" always;
    add_header X-XSS-Protection "1; mode=block" always;
    add_header Referrer-Policy "strict-origin-when-cross-origin" always;

    # Content-Security-Policy (Landing). 'unsafe-inline' fuer Next.js-Hydration & Tailwind
    # (keine Nonce-Middleware). Widgets (Cookie/Accessibility) laden von api.complyo.de;
    # Cookie-Widget zieht Google-Fonts-CSS, YouTube-Embed im Video-Demo.
    add_header Content-Security-Policy "default-src 'self'; script-src 'self' 'unsafe-inline' https://api.complyo.de; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com https://api.complyo.de; font-src 'self' data: https://fonts.gstatic.com; img-src 'self' data: blob: https://cdn.complyo.tech https://api.complyo.de https://i.ytimg.com; connect-src 'self' https://api.complyo.de https://app.complyo.de https://cdn.complyo.tech; frame-src https://www.youtube.com https://www.youtube-nocookie.com; frame-ancestors 'self'; base-uri 'self'; form-action 'self' https://app.complyo.de; object-src 'none'; upgrade-insecure-requests" always;

    location / {
        # Bot-Schutz: App nutzt keine Next.js Server Actions -> Probes mit Next-Action-Header verwerfen
        if ($http_next_action) { return 444; }

        proxy_pass http://127.0.0.1:3003;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    # Oeffentlicher Pruefnachweis (11.09.2026). Die Barrierefreiheitserklaerung
    # jedes Kunden verlinkt auf https://complyo.de/nachweis/<site>/<token>.
    # Bis heute landete dieser Link auf der Landing, die keine solche Seite hat:
    # jede ausgelieferte Erklaerung zeigte ins Leere. Das Backend liefert das
    # Protokoll unter /api/nachweis/...; hier wird nur umgeschrieben. Token sind
    # 32 Hex-Zeichen, Site-Kennungen Kleinbuchstaben, Ziffern und Bindestriche;
    # alles andere faellt weiter auf die Landing (404 dort).
    location ~ "^/nachweis/([a-z0-9-]+)/([a-f0-9]{32})/erklaerung/?$" {
        proxy_pass http://127.0.0.1:8002/api/nachweis/$1/$2/erklaerung/seite;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }
    location ~ "^/nachweis/([a-z0-9-]+)/([a-f0-9]{32})/?$" {
        proxy_pass http://127.0.0.1:8002/api/nachweis/$1/$2/seite;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    listen 443 ssl; # managed by Certbot
    ssl_certificate /etc/letsencrypt/live/complyo.de/fullchain.pem; # managed by Certbot
    ssl_certificate_key /etc/letsencrypt/live/complyo.de/privkey.pem; # managed by Certbot
    include /etc/letsencrypt/options-ssl-nginx.conf; # managed by Certbot
    ssl_dhparam /etc/letsencrypt/ssl-dhparams.pem; # managed by Certbot



}

server {
    server_name app.complyo.de;

    # Security Headers (AUDIT-04, v2.0 milestone Phase 1)
    add_header Strict-Transport-Security "max-age=31536000; includeSubDomains; preload" always;
    add_header X-Content-Type-Options "nosniff" always;
    add_header X-Frame-Options "SAMEORIGIN" always;
    add_header X-XSS-Protection "1; mode=block" always;
    add_header Referrer-Policy "strict-origin-when-cross-origin" always;

    location / {
        # Bot-Schutz: App nutzt keine Next.js Server Actions -> Probes mit Next-Action-Header verwerfen
        if ($http_next_action) { return 444; }

        proxy_pass http://127.0.0.1:3001;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    listen 443 ssl; # managed by Certbot
    ssl_certificate /etc/letsencrypt/live/complyo.de/fullchain.pem; # managed by Certbot
    ssl_certificate_key /etc/letsencrypt/live/complyo.de/privkey.pem; # managed by Certbot
    include /etc/letsencrypt/options-ssl-nginx.conf; # managed by Certbot
    ssl_dhparam /etc/letsencrypt/ssl-dhparams.pem; # managed by Certbot


}

server {
    server_name api.complyo.de;

    # Security Headers (AUDIT-04, v2.0 milestone Phase 1)
    add_header Strict-Transport-Security "max-age=31536000; includeSubDomains; preload" always;
    add_header X-Content-Type-Options "nosniff" always;
    add_header X-Frame-Options "SAMEORIGIN" always;
    add_header X-XSS-Protection "1; mode=block" always;
    add_header Referrer-Policy "strict-origin-when-cross-origin" always;

    location / {
        # CORS preflight
        if ($request_method = OPTIONS) {
            add_header Access-Control-Allow-Origin $cors_allow_origin always;
            add_header Access-Control-Allow-Credentials $cors_allow_credentials always;
            add_header Access-Control-Allow-Methods "GET, POST, PUT, DELETE, OPTIONS, PATCH" always;
            add_header Access-Control-Allow-Headers "Content-Type, Authorization, X-Requested-With, X-CSRF-Token, Accept, Origin, Cache-Control" always;
            add_header Access-Control-Max-Age 86400 always;
            add_header Content-Length 0 always;
            return 204;
        }

        add_header Access-Control-Allow-Origin $cors_allow_origin always;
        add_header Access-Control-Allow-Credentials $cors_allow_credentials always;

        proxy_pass http://127.0.0.1:8002;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_read_timeout 120s;
        proxy_send_timeout 120s;
        proxy_connect_timeout 10s;

        proxy_hide_header Access-Control-Allow-Origin;
        proxy_hide_header Access-Control-Allow-Credentials;
    }

    listen 443 ssl; # managed by Certbot
    ssl_certificate /etc/letsencrypt/live/complyo.de/fullchain.pem; # managed by Certbot
    ssl_certificate_key /etc/letsencrypt/live/complyo.de/privkey.pem; # managed by Certbot
    include /etc/letsencrypt/options-ssl-nginx.conf; # managed by Certbot
    ssl_dhparam /etc/letsencrypt/ssl-dhparams.pem; # managed by Certbot


}

server {
    server_name dashboard.complyo.de;

    # Security Headers (AUDIT-04, v2.0 milestone Phase 1)
    add_header Strict-Transport-Security "max-age=31536000; includeSubDomains; preload" always;
    add_header X-Content-Type-Options "nosniff" always;
    add_header X-Frame-Options "SAMEORIGIN" always;
    add_header X-XSS-Protection "1; mode=block" always;
    add_header Referrer-Policy "strict-origin-when-cross-origin" always;

    location / {
        # Bot-Schutz: App nutzt keine Next.js Server Actions -> Probes mit Next-Action-Header verwerfen
        if ($http_next_action) { return 444; }

        proxy_pass http://127.0.0.1:3001;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    listen 443 ssl; # managed by Certbot
    ssl_certificate /etc/letsencrypt/live/dashboard.complyo.de/fullchain.pem; # managed by Certbot
    ssl_certificate_key /etc/letsencrypt/live/dashboard.complyo.de/privkey.pem; # managed by Certbot
    include /etc/letsencrypt/options-ssl-nginx.conf; # managed by Certbot
    ssl_dhparam /etc/letsencrypt/ssl-dhparams.pem; # managed by Certbot

}
server {
    if ($host = www.complyo.de) {
        return 301 https://$host$request_uri;
    } # managed by Certbot


    if ($host = complyo.de) {
        return 301 https://$host$request_uri;
    } # managed by Certbot


    listen 80;
    server_name complyo.de www.complyo.de;
    return 404; # managed by Certbot




}

server {
    if ($host = app.complyo.de) {
        return 301 https://$host$request_uri;
    } # managed by Certbot


    listen 80;
    server_name app.complyo.de;
    return 404; # managed by Certbot


}

server {
    if ($host = api.complyo.de) {
        return 301 https://$host$request_uri;
    } # managed by Certbot


    listen 80;
    server_name api.complyo.de;
    return 404; # managed by Certbot


}

server {
